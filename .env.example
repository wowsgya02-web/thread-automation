# Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Telegram (BotFather 토큰 + 본인 chat_id)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Meta Threads Graph API (브라우저 로그인 대신)
# 대시보드에서 사용자별로 넣어도 되고, 여기에 넣으면 전역 기본값으로 씁니다.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# 발행 후 첫 댓글(답글)로 달 서비스 링크
SERVICE_URL=https://your-service.example
SERVICE_NAME=MyService

# 경로 (프로젝트 루트 기준)
DOCS_DIR=docs
DATABASE_PATH=database/history.db
SESSION_PATH=session/threads_session.json
THREADS_BASE_URL=https://www.threads.com

# 중복 방지
DEDUP_DAYS=7

# 생성 언어: ko | en
LANGUAGE=ko

# 스케줄 기본값. 대시보드에서 저장하면 state/publish_schedule.json이 우선합니다.
TIMEZONE=Asia/Seoul
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# 텔레그램 승인 대기 제한(초). once 모드 전용. 0이면 무제한
REVIEW_TIMEOUT_SECONDS=1800

# 웹 대시보드 계정 DB (사용자별 스케줄은 state/users/<아이디>/)
ACCOUNTS_PATH=database/accounts.db
